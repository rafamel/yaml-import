    "commit": "kpo commit --",
    "release": "kpo release --",
    "distribute": "kpo distribute --",
    "validate": "kpo validate --",
    "version": "kpo version --"
  },
  "homepage": "https://github.com/rafamel/yaml-import",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafamel/yaml-import.git"
  },
  "bugs": {
    "url": "https://github.com/rafamel/yaml-import/issues"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.21.1",
